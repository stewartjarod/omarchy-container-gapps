#!/bin/bash

# Open the Mail or Calendar app on the current workspace, or, if it is
# already open, switch to it wherever it is.
# usage: omarchy-container-gapps mail|calendar [--compose]
#        omarchy-container-gapps add <label> [email] [mail|cal|mail,cal] [color]
#        omarchy-container-gapps addons   (install 1Password etc. in the app)

set -euo pipefail

APP_ID=omarchy-container-gapps
ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
PROFILE=${XDG_DATA_HOME:-$HOME/.local/share}/$APP_ID/profile
FIREFOX=${GAPPS_FIREFOX:-/usr/lib/firefox/firefox}
ACCOUNTS=${XDG_CONFIG_HOME:-$HOME/.config}/$APP_ID/accounts

usage() {
  cat >&2 <<USAGE
usage: $APP_ID mail|calendar [--compose]
       $APP_ID add <label> [email] [mail|cal|mail,cal] [color]
       $APP_ID addons
USAGE
  exit 1
}

# Add a line to the accounts file. Open windows pick it up within 2s and show
# a new pill on Google's sign-in page.
add_account() {
  local label=${1:-} email="" apps=mail,cal color="" arg
  [[ -n $label && $label != -* ]] || usage
  if [[ $label =~ [[:space:]#] ]]; then
    echo "$APP_ID: the label must be one word, without #" >&2
    exit 1
  fi
  shift
  for arg in "$@"; do
    case $arg in
      *@*) email=$arg ;;
      mail | cal | calendar | mail,cal | cal,mail | mail,calendar) apps=$arg ;;
      *) color=$arg ;;
    esac
  done

  mkdir -p "$(dirname "$ACCOUNTS")"
  touch "$ACCOUNTS"
  if awk -v label="$label" '{ sub(/#.*/, "") } $1 == label { found = 1 } END { exit !found }' "$ACCOUNTS"; then
    echo "$APP_ID: $label is already in $ACCOUNTS" >&2
    exit 1
  fi
  [[ -s $ACCOUNTS && $(tail -c1 "$ACCOUNTS") != "" ]] && echo >>"$ACCOUNTS"
  printf '%-10s %-10s %s %s\n' "$label" "$apps" "$email" "$color" | sed 's/ *$//' >>"$ACCOUNTS"
  echo "Added $label. Its pill opens on Google's sign-in page."
}

case ${1:-} in
  mail) role=mail title=Mail ;;
  cal | calendar) role=calendar title=Calendar ;;
  addons) role=addons title=Mail ;;
  add)
    shift
    add_account "$@"
    exit 0
    ;;
  *) usage ;;
esac
request="about:blank?gapps=$role"
[[ ${2:-} == --compose ]] && request+="&compose"

find_window() {
  hyprctl clients -j | jq -r --arg class "$APP_ID" --arg title "$title · " \
    '[.[] | select(.class == $class and (.title | startswith($title)))][0].address // empty'
}

# The workspace you were on when you asked. Read it once, up front: Firefox
# may open the window next to the other app's window and pull focus there.
WORKSPACE=$(hyprctl activeworkspace -j | jq -r '.id')

# Focusing a window also switches to its workspace.
focus() {
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null
}

bring_here() {
  focus "$1"
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"$WORKSPACE\" })" >/dev/null
}

# Firefox's profile lock is a symlink to "<ip>:+<pid>" while it runs.
running() {
  local lock
  lock=$(readlink "$PROFILE/lock" 2>/dev/null) || return 1
  kill -0 "${lock##*+}" 2>/dev/null
}

mkdir -p "$PROFILE"
ln -sfn "$ROOT/firefox" "$PROFILE/gapps"
ln -sf "$ROOT/firefox/user.js" "$PROFILE/user.js"

existing=$(find_window)
if [[ -n $existing ]]; then
  focus "$existing"
  # Compose and addons still go to Firefox, which acts in that window.
  [[ $role == addons || $request == *compose ]] || exit 0
fi

if running; then
  "$FIREFOX" --profile "$PROFILE" --new-tab "$request"
else
  setsid "$FIREFOX" --class "$APP_ID" --name "$APP_ID" --profile "$PROFILE" --new-window "$request" \
    >/dev/null 2>&1 </dev/null &
fi

for _ in {1..100}; do
  address=$(find_window)
  [[ -n $address ]] && break
  sleep 0.1
done
# A window that was already open stays where it is; a new one comes here.
if [[ -n $address && -z $existing ]]; then
  bring_here "$address"
fi
